    border-radius: 4px;
	padding: 8px;
	margin-top: 1ex;
    color: rgb(47, 65, 87);
    font-weight: bold;
    font-size: 16px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
}

QPushButton {
	background-color: rgb(87, 124, 142);
    color: white;
    border: none;
    border-radius: 4px;
    padding: 6px 12px;
    min-height: 28px;
    margin: 2px;
}

QPushButton:hover {
    background-color: rgba(87, 124, 142, 0.85);
}

