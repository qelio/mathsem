}

QGroupBox QLabel {
	background: white;
}

QSpinBox {
    min-width: 50px;
    font-size: 14px;
	background-color: white;
    border: 1px solid rgb(200, 200, 200);
    border-radius: 4px;
    padding: 4px;
    min-height: 20px;
    color: rgb(47, 65, 87);
}

QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: right top;
    width: 16px;
    height: 18px;
}

QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: right bottom;
    width: 16px;
    height: 18px;
}

QComboBox {
    background-color: white;
    border: 1px solid rgb(200, 200, 200);
    border-radius: 4px;
    padding: 4px;
    min-height: 20px;
    color: rgb(47, 65, 87);
}

QComboBox:hover, QSpinBox:hover {
    border: 1px solid rgb(87, 124, 142);
}

QComboBox QAbstractItemView {
    background-color: white;
    color: rgb(30, 30, 30);
}

QComboBox::drop-down {
    border: none;
    width: 0;
    padding: 0;
    margin: 0;
}

QComboBox::down-arrow {
    image: none;
}

QComboBox QScrollBar:vertical {
    width: 0px;
    background: transparent;
}</string>
