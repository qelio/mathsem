   <string notr="true">QMainWindow {
    background-color: rgb(244, 239, 235);
    font-family: &quot;Segoe UI&quot;, Helvetica, Arial, sans-serif;
}

QGroupBox {
    background-color: rgb(255, 255, 255);
    border: 1px solid rgb(200, 200, 200);
    border-radius: 4px;
    margin-top: 1ex;
    padding: 8px;
    color: rgb(47, 65, 87);
    font-weight: bold;
    font-size: 16px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
}

QTableWidget {
    background-color: white;
    border-radius: 4px;
    border: 1px solid rgb(200, 200, 200);
    gridline-color: rgb(230, 230, 230);
    font-size: 14px;
    color: rgb(30, 30, 30);
}

QHeaderView::section {
    background-color: rgb(47, 65, 87);
    color: white;
    padding: 4px;
    border: none;
    font-weight: bold;
}

QTableWidget::item {
    padding: 4px;
    color: rgb(30, 30, 30);
}

QComboBox {
    background-color: white;
    border: 1px solid rgb(200, 200, 200);
    border-radius: 4px;
    padding: 4px;
    min-height: 24px;
    color: rgb(47, 65, 87);
}

QComboBox:hover {
    border: 1px solid rgb(87, 124, 142);
}

QComboBox QAbstractItemView {
    background-color: white;
    color: rgb(47, 65, 87);
    selection-background-color: rgb(87, 124, 142);
    selection-color: white;
    border: 1px solid rgb(200, 200, 200);
}

QComboBox::drop-down {
    border: none;
    width: 0;
    padding: 0;
    margin: 0;
}

QComboBox::down-arrow {
    image: none;
}

QPushButton {
    background-color: rgb(87, 124, 142);
    color: white;
    border: none;
    border-radius: 4px;
    padding: 6px 12px;
    min-height: 28px;
    margin: 2px;
}

QPushButton:hover {
    background-color: rgba(87, 124, 142, 0.85);
}

QPushButton:pressed {
    background-color: rgba(87, 124, 142, 0.75);
}

/* Специфичные стили для кнопок в группе ввода */
QGroupBox#groupBox_2 QPushButton {
    background-color: transparent;
    color: rgb(47, 65, 87);
    border: 1px solid rgb(200, 200, 200);
    font-size: 16px;
    min-width: 32px;
    min-height: 32px;
}

QGroupBox#groupBox_2 QPushButton:hover {
    background-color: rgba(87, 124, 142, 0.1);
}

/* Стили для меню и статусбара */
QMenuBar {
    background-color: rgb(47, 65, 87);
    color: white;
}

QStatusBar {
    background-color: rgb(47, 65, 87);
    color: white;
    padding: 4px;
}

QTableWidget QLineEdit {
    background-color: white;
    color: rgb(30, 30, 30);
    border: 1px solid rgb(87, 124, 142);
    border-radius: 2px;
    padding: 2px;
}</string>
